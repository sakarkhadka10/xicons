{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/icons/**",
        "$TURBO_ROOT$/scripts/build-ui-icons.ts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/icons/**",
        "$TURBO_ROOT$/scripts/build-ui-icons.ts"
      ]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/icons/**",
        "$TURBO_ROOT$/scripts/build-ui-icons.ts"
      ]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/icons/**",
        "$TURBO_ROOT$/scripts/build-ui-icons.ts"
      ]
    }
  }
}
