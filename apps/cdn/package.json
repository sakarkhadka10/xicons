    "test": "tsc -p tsconfig.json && node --test test/*.test.js"
  },
  "dependencies": {
    "@axcore/xicons": "workspace:*",
    "hono": "^4.9.8",
    "@hono/node-server": "^2.1.3"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "@types/node": "^26.6.4"
  }
}
