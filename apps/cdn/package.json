{
  "name": "@axcore/xicons-cdn",
  "version": "0.1.0",
  "private": true,
  "description": "URL/CDN SVG renderer for XIcons.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
