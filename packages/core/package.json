{
  "name": "@axcore/xicons",
  "version": "0.1.2",
  "description": "Developer icon registry with original and mono SVG variants.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakarkhadka10/xicons.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sakarkhadka10/xicons/issues"
  },
  "homepage": "https://github.com/sakarkhadka10/xicons/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "icons",
    "svg",
    "developer",
    "tech-stack",
    "registry",
    "xicons",
    "axcore"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-icons.mjs",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "lint": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run generate && tsc -p tsconfig.json && node --test test/*.test.js"
  }
}
