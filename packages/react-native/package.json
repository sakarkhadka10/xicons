{
  "name": "@axcore/xicons-react-native",
  "version": "0.2.0",
  "description": "React Native and Expo Icon component for XIcons.",
  "keywords": [
    "axcore",
    "expo",
    "icons",
    "react-native",
    "svg",
    "xicons"
  ],
  "homepage": "https://github.com/sakarkhadka10/xicons/tree/main/packages/react-native#readme",
  "bugs": {
    "url": "https://github.com/sakarkhadka10/xicons/issues"
  },
  "license": "MIT",
  "author": "sakarkhadka10 (https://github.com/sakarkhadka10)",
  "contributors": [
    "sakarkhadka10 (https://github.com/sakarkhadka10)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakarkhadka10/xicons.git",
    "directory": "packages/react-native"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx ../../scripts/build-ui-icons.ts jsx",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@axcore/xicons": "workspace:*",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.6"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-native": ">=0.78"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
