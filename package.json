{
  "name": "xicons",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source developer icon ecosystem by AXCore.",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json",
    "test": "turbo run test",
    "validate": "pnpm --filter @axcore/xicons-icon-validator validate && pnpm typecheck && pnpm lint && pnpm test",
    "pack:verify": "tsx scripts/verify-publish-readiness.ts",
    "publish:dry-run": "tsx scripts/publish-dry-run.ts",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakarkhadka10/xicons.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "tsx": "^4.20.6",
    "typescript": "7.0.2"
  }
}
